# Required for AI-assisted kit generation (the "Import repo → generate kit" flow).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a GitHub token raises the API rate limit for repo import and lets you
# import private repositories. A fine-grained token with "Contents: read" is enough.
# GITHUB_TOKEN=ghp_...
