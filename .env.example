# Required for AI-assisted kit generation (the "Import repo → generate kit" flow).
# Any OpenAI-compatible chat endpoint works.
OPENAI_API_KEY=sk-...

# Optional: point at a different OpenAI-compatible endpoint.
#   - Azure OpenAI:            https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   - Local / Docker Model Runner: http://localhost:12434/engines/v1
# OPENAI_BASE_URL=

# Optional: model to use for generation (default: gpt-4o).
# OPENAI_MODEL=gpt-4o

# Optional: a GitHub token raises the API rate limit for repo import and lets you
# import private repositories. A fine-grained token with "Contents: read" is enough.
# GITHUB_TOKEN=ghp_...
